# Copy to fleet.env (not versioned) and fill in.

# Coordinator: Tailscale IP of its machine (the VPS), private port for workers
# and admin, loopback port the reverse proxy forwards the public site to.
COORD_IP=100.64.0.1
COORD_PORT=8787
PUBLIC_PORT=8788

# Wake-on-LAN relay on an always-on machine of the home LAN (the mini).
RELAY_IP=100.64.0.2
RELAY_PORT=8789
# Machines the relay can wake: machine=mac@lan-broadcast,... and their names.
WAKE="pc=00:11:22:33:44:55@192.168.1.255"
WAKEABLE=pc
